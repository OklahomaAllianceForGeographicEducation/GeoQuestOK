{
  "expo": {
    "name": "GeoQuestOK",
    "slug": "geoquestok",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/GeoQuestOK_ios_logo.png",
    "scheme": "geoquestok",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "org.geoquestok.app",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "org.geoquestok.app",
      "adaptiveIcon": {
        "backgroundColor": "#f6efe7",
        "foregroundImage": "./assets/images/GeoQuestOK_android_foreground_safe.png",
        "backgroundImage": "./assets/images/GeoQuestOK_android_background.png",
        "monochromeImage": "./assets/images/GeoQuestOK_android_monochrome_safe.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/Favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/GeoQuestOK_android_foreground_safe.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f6efe7"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "geoquestok"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7091432c-5afc-4d21-819c-f1cf2a71f5b9"
      }
    },
    "owner": "geoquestok"
  }
}
{
  "expo": {
    "name": "GeoQuest OK",
    "slug": "expo-test-dev",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/GeoQuestOK ios Logo.png",
    "scheme": "expotestdev",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "splash": {
        "image": "./assets/images/GeoQuestOK ios Logo.png",
        "resizeMode": "cover"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1f5d50",
        "foregroundImage": "./assets/images/android.adaptiveIcon.foregroundImage.png",
        "backgroundImage": "./assets/images/android.adaptiveIcon.backgroundColor.png",
        "monochromeImage": "./assets/images/android.adaptiveIcon.monochromeImage.png"
      },
      "splash": {
        "ldpi": "./assets/images/splashScreens/Android LDPI Splash Screen.png",
        "mdpi": "./assets/images/splashScreens/Android MDPI Splash Screen.png",
        "hdpi": "./assets/images/splashScreens/Android HDPI Splash Screen.png",
        "xhdpi": "./assets/images/splashScreens/Android XHDPI Splash Screen.png",
        "xxhdpi": "./assets/images/splashScreens/Android XXHDPI Splash Screen.png",
        "xxxhdpi": "./assets/images/splashScreens/Android XXXHDPI Splash Screen.png",
        "resizeMode": "cover"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/web.favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "geoquestok"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}